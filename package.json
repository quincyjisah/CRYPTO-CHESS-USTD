{
  "name": "crypto-chess-ustd",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A minimal TypeScript web app scaffold for a Crypto Chess USDT wager lobby.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --check .",
    "audit": "npm audit --audit-level=moderate",
    "server:ws": "tsx server/ws.ts",
    "server:matchmaker": "tsx -e \"import { getRedis } from './lib/redisBus.ts'; import { startMatchmaker } from './server/matchmaker.ts'; await startMatchmaker(getRedis());\"",
    "typecheck": "tsc --noEmit",
    "server:app": "tsx server/static.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@types/node": "^25.6.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.26.0",
    "globals": "^16.1.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "ioredis": "^5.10.1",
    "ws": "^8.20.0",
    "tsx": "^4.21.0"
  }
}
