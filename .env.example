# Public AdSense publisher client used by the browser ad script.
# Keep customer IDs, payment profile IDs, payment account IDs, tax data, and bank data out of Git.
VITE_ADSENSE_CLIENT=ca-pub-8165457408564080

# Optional public ad slot ID from Google AdSense.
VITE_ADSENSE_SLOT=

# Shared secret used for HMAC-signed session tokens in API/WS auth.
# Replace for every environment; never use this default in production.
SESSION_SECRET=replace-with-random-64-byte-secret
