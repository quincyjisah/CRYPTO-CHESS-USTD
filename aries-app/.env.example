# ═══════════════════════════════════════════════════════════════════
# ARIES PROTOCOL — Environment Variables
# Owner: quincy.j.isah@gmail.com
# Copy this file to .env.local and fill ALL values before deploying.
# NEVER commit .env.local to Git.
# ═══════════════════════════════════════════════════════════════════

# ─── Firebase ──────────────────────────────────────────────────────
# Firebase Console → Project Settings → Your apps → Web app → Config
VITE_FIREBASE_API_KEY="AIza..."
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_APP_ID="1:..."
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="746923156654"

# ─── Alchemy ───────────────────────────────────────────────────────
# dashboard.alchemy.com → Create App → Ethereum Mainnet → View Key
# Restrict this key to your production domain in Alchemy dashboard.
VITE_ALCHEMY_API_KEY="your_alchemy_api_key_here"

# ─── OpenSea ───────────────────────────────────────────────────────
# docs.opensea.io/reference/api-keys
VITE_OPENSEA_API_KEY="your_opensea_api_key_here"

# ─── Smart Contracts ───────────────────────────────────────────────
# Fill these after running: npx hardhat run scripts/deploy.js --network mainnet
VITE_NFT_CONTRACT_ADDRESS="0x_YOUR_NFT_CONTRACT_ADDRESS"
VITE_VAULT_CONTRACT_ADDRESS="0x_YOUR_VAULT_CONTRACT_ADDRESS"

# ─── Google AdSense (quincy.j.isah@gmail.com) ─────────────────────
# adsense.google.com → apply → wait for approval → get publisher ID
VITE_ADSENSE_PUB_ID="ca-pub-REPLACE_WITH_YOUR_PUBLISHER_ID"
# After approval: create 3 ad units → copy slot IDs
VITE_ADSENSE_SLOT_SQUARE="REPLACE_SQUARE_SLOT_ID"
VITE_ADSENSE_SLOT_BANNER="REPLACE_BANNER_SLOT_ID"
VITE_ADSENSE_SLOT_NATIVE="REPLACE_NATIVE_SLOT_ID"

# ─── WalletConnect ─────────────────────────────────────────────────
# cloud.walletconnect.com → create project → copy project ID (free)
VITE_WALLETCONNECT_PROJECT_ID="your_walletconnect_project_id"

# ─── Treasury ──────────────────────────────────────────────────────
# Your Ethereum wallet that receives the 2% protocol fee from winners.
VITE_TREASURY_ADDRESS="0x_YOUR_TREASURY_WALLET_ADDRESS"

# ─── Firebase App Check / reCAPTCHA ────────────────────────────────
# google.com/recaptcha/admin → create v3 site key
VITE_RECAPTCHA_SITE_KEY="your_recaptcha_v3_site_key"

# ─── AI Studio (injected automatically in AI Studio runtime) ───────
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# ─── WebSocket Backend ─────────────────────────────────────────────────────────
# URL of the production WebSocket server (from backend/src/ws/server.ts)
# Local dev: ws://localhost:8080/ws
# Production: wss://ws.ariesprotocol.app/ws
VITE_WS_URL="wss://ws.ariesprotocol.app/ws"
