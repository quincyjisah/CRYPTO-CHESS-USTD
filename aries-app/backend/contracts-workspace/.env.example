# Local Hardhat development uses a generated mock ERC-20 and needs no secrets.

# Explicit opt-in required for Sepolia deployment.
ALLOW_SEPOLIA_DEPLOYMENT=false
DEPLOYER_PRIVATE_KEY=
ALCHEMY_API_KEY=
ETHERSCAN_API_KEY=

# Sepolia ERC-20 contracts; set only addresses deployed on Sepolia.
SEPOLIA_USDT=
SEPOLIA_USDC=
SEPOLIA_DAI=

# Remote roles must be six distinct addresses, including DEPLOYER_PRIVATE_KEY.
TREASURY_ADDRESS=
ADMIN_ADDRESS=
SETTLER_ADDRESS=
PAUSER_ADDRESS=
MINTER_ADDRESS=
