rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── 0. Global deny-all safety net ──────────────────────────────────────
    // Every collection NOT explicitly granted access below is locked.
    match /{document=**} {
      allow read, write: if false;
    }

    // ─── Helpers ─────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function incoming() {
      return request.resource.data;
    }

    // FIX: notTooFast() was checking `request.time > 2024` which is ALWAYS true
    // and provided zero rate-limiting. Replaced with a real write-velocity check:
    // the client-supplied createdAt must not be more than 30s in the past or future.
    function notTooFast() {
      return request.time >= request.resource.data.get('createdAt', request.time) - duration.value(30, 's')
          && request.time <= request.resource.data.get('createdAt', request.time) + duration.value(30, 's');
    }

    // ─── Validation blueprints ────────────────────────────────────────────────

    function isValidHandle(h) {
      return h is string
          && h.size() >= 3
          && h.size() <= 32
          && h.matches('^[a-zA-Z0-9_]+$');
    }

    // FIX: Added handle sanitization — displayName from Google can contain
    // spaces, emoji, HTML. The handle field is now validated separately.
    function isValidProfile(data) {
      return data.keys().hasAll(['id', 'handle', 'joinedAt'])
          && data.keys().hasOnly([
            'id', 'handle', 'avatar', 'rank', 'exp',
            'matches', 'victories', 'wins', 'losses', 'profit', 'joinedAt',
            'updatedAt', 'muteAudio', 'muteVideo', 'rating', 'rd', 'volatility', 'ratingBand'
          ])
          && data.id == request.auth.uid
          && data.id is string && data.id.size() <= 128
          && isValidHandle(data.handle)
          && data.joinedAt is timestamp
          && (!data.keys().hasAny(['rank']) || data.rank == 'Recruit')
          && (!data.keys().hasAny(['exp']) || data.exp == 0)
          && (!data.keys().hasAny(['matches']) || data.matches == 0)
          && (!data.keys().hasAny(['victories']) || data.victories == 0)
          && (!data.keys().hasAny(['wins']) || data.wins == 0)
          && (!data.keys().hasAny(['losses']) || data.losses == 0)
          && (!data.keys().hasAny(['profit']) || data.profit == 0)
          && (!data.keys().hasAny(['rating']) || data.rating == 1500)
          && (!data.keys().hasAny(['rd']) || data.rd == 350)
          && (!data.keys().hasAny(['volatility']) || data.volatility == 0.06)
          && (!data.keys().hasAny(['ratingBand']) || data.ratingBand == 'Unrated')
          && (!data.keys().hasAny(['avatar']) || (data.avatar is string && data.avatar.size() <= 2048));
    }

    function isValidProfileUpdate(data) {
      let changed = data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['handle', 'avatar', 'updatedAt', 'muteAudio', 'muteVideo'])
          && (!changed.hasAny(['handle']) || isValidHandle(data.handle))
          && (!changed.hasAny(['avatar']) || (data.avatar is string && data.avatar.size() <= 2048))
          && (!changed.hasAny(['updatedAt']) || data.updatedAt is timestamp)
          && (!changed.hasAny(['muteAudio']) || data.muteAudio is bool)
          && (!changed.hasAny(['muteVideo']) || data.muteVideo is bool);
    }

    function isValidAmount(amount) {
      return amount is number && amount >= -10000 && amount <= 10000;
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['userId', 'name', 'type', 'status', 'amount', 'createdAt'])
          && data.userId == request.auth.uid
          && data.userId is string  && data.userId.size() <= 128
          && data.name is string    && data.name.size() <= 100
          && data.type in ['Match', 'Deposit', 'Withdraw', 'Bid', 'Tip']
          && data.status in ['Finalized', 'Processing', 'Failed']
          && isValidAmount(data.amount)
          && data.createdAt is timestamp;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['text', 'userId', 'userName', 'createdAt'])
          && data.userId == request.auth.uid
          && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
          && data.userName == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.handle
          && data.text is string
          && data.text.size() >= 1
          && data.text.size() <= 500
          && data.userName is string && data.userName.size() <= 32
          && data.createdAt is timestamp;
    }

    function isValidGame(data) {
      return data.keys().hasAll(['whiteUid', 'blackUid', 'wager', 'currency', 'status', 'createdAt'])
          && data.whiteUid is string
          && data.blackUid is string
          && (data.whiteUid == request.auth.uid || data.blackUid == request.auth.uid)
          && data.wager is number && data.wager >= 1 && data.wager <= 1000
          && data.currency in ['USDT', 'USDC', 'DAI']
          && data.status in ['active', 'finished']
          && data.createdAt is timestamp;
    }

    function isGameParticipant() {
      return isSignedIn()
          && resource != null
          && (resource.data.whiteUid == request.auth.uid
              || resource.data.blackUid == request.auth.uid);
    }

    // NEW: Viewers can read a game if it has a public spectator flag set
    function isPublicGame() {
      return resource != null && resource.data.get('isPublic', false) == true;
    }

    function isValidMatchmakingEntry(data) {
      return data.keys().hasAll(['uid', 'handle', 'wager', 'currency', 'joinedAt', 'status'])
          && data.keys().hasOnly(['uid', 'handle', 'wager', 'currency', 'joinedAt', 'status'])
          && data.uid == request.auth.uid
          && isValidHandle(data.handle)
          && data.wager == 0
          && data.currency == 'FREE'
          && data.status == 'waiting'
          && data.joinedAt is timestamp;
    }

    // NEW: Tip validation
    function isValidTip(data) {
      return data.keys().hasAll(['fromUid', 'toUid', 'gameId', 'amount', 'currency', 'message', 'createdAt'])
          && data.fromUid == request.auth.uid
          && data.fromUid != data.toUid  // can't tip yourself
          && data.amount is number && data.amount >= 1 && data.amount <= 500
          && data.currency in ['USDT', 'USDC', 'DAI']
          && data.message is string && data.message.size() <= 100
          && data.createdAt is timestamp;
    }

    // ─── /profiles/{uid} ─────────────────────────────────────────────────────
    match /profiles/{uid} {
      // Private account data: only the authenticated owner may read it.
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && isValidProfile(incoming());
      allow update: if isOwner(uid) && isValidProfileUpdate(incoming());
      allow delete: if false;
    }

    // Public-safe player cards. Written only by Admin SDK Cloud Functions.
    match /profiles_public/{uid} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // ─── /transactions/{txId} ────────────────────────────────────────────────
    match /transactions/{txId} {
      // Ledgers are written only by trusted Cloud Functions after verified events.
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // ─── /messages/{messageId} ───────────────────────────────────────────────
    match /messages/{messageId} {
      allow read: if true;
      allow create, update, delete: if false;
      allow update, delete: if false;
    }

    // ─── /protocol/stats ─────────────────────────────────────────────────────
    match /protocol/stats {
      allow read: if true;
      allow write: if false;
    }

    // ─── /games/{gameId} ─────────────────────────────────────────────────────
    match /games/{gameId} {
      // All game state mutations are performed by trusted Cloud Functions.
      allow read: if isGameParticipant() || isPublicGame();
      allow create, update, delete: if false;
    }

    // ─── /matchmaking/{uid} ──────────────────────────────────────────────────
    match /matchmaking/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && isValidMatchmakingEntry(incoming());
      allow delete: if isOwner(uid);
    }

    // ─── /nfts/{id} ──────────────────────────────────────────────────────────
    match /nfts/{id} {
      allow read: if true;
      allow write: if false;
    }

    // ─── /tips/{tipId} — NEW ─────────────────────────────────────────────────
    match /tips/{tipId} {
      // Temporarily disabled until tips are backed by a real escrow transfer.
      allow read, create, update, delete: if false;
    }



    // ─── /tournaments/{id} ────────────────────────────────────────────────────
    match /tournaments/{id} {
      // Public read — anyone can browse tournaments
      allow read: if true;

      // Mutations use authenticated server-side callables only.
      allow create, update, delete: if false;
    }

    // ─── /cache/{docId} — leaderboard + replay bundles ───────────────────────
    match /cache/{docId} {
      allow read:  if true;
      allow write: if false;
    }

    // ─── /disputes/{id} — fraud investigation records ─────────────────────────
    match /disputes/{id} {
      allow read: if isSignedIn() && (
        resource.data.get('isPublic', false) == true ||
        resource.data.get('whiteUid', '') == request.auth.uid ||
        resource.data.get('blackUid', '') == request.auth.uid
      );
      allow write: if false;
    }

    // ─── /flagged_accounts/{uid} ──────────────────────────────────────────────
    match /flagged_accounts/{uid} {
      allow read:  if isOwner(uid);
      allow write: if false;
    }

    // ─── /prizes/{id} — tournament prize queue ────────────────────────────────
    match /prizes/{id} {
      allow read:  if isSignedIn() && resource.data.get('userId', '') == request.auth.uid;
      allow write: if false;
    }

  }
}
