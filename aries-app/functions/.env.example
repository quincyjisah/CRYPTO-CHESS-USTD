# Aries Protocol — Cloud Functions Environment Variables
# Set these via Firebase Secrets Manager (NOT plain env vars for sensitive values):
#   firebase functions:secrets:set TREASURY_ADDRESS
#   firebase functions:secrets:set ALCHEMY_RPC_URL
#   firebase functions:secrets:set ARIES_TREASURY_PRIVATE_KEY

# Treasury wallet address (not secret — just an address)
TREASURY_ADDRESS="0x_YOUR_TREASURY_WALLET_ADDRESS"

# Alchemy RPC URL for on-chain transactions from Cloud Functions
ALCHEMY_RPC_URL="https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY"

# Treasury private key — ONLY set via Secret Manager, NEVER in plain text
# firebase functions:secrets:set ARIES_TREASURY_PRIVATE_KEY
# Then reference in function: process.env.ARIES_TREASURY_PRIVATE_KEY
