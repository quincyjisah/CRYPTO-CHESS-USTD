{
  "name": "aries-protocol-functions",
  "version": "1.0.0",
  "description": "Aries Protocol Cloud Functions \u2014 server-side settlement, fraud detection, matchmaking",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
