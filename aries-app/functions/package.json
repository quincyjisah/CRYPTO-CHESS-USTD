  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "ethers": "^6.16.0",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.9.3"
  }
}
