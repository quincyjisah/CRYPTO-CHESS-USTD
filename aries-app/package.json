    "chess.js": "^1.4.0",
    "dotenv": "^17.2.3",
    "ethers": "^6.16.0",
    "firebase": "^12.12.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-chessboard": "^5.10.0",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.0.0",
